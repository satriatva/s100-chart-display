    "s-102",
    "s-104",
    "iho",
    "hydrography",
    "nautical-chart",
    "enc",
    "bathymetry",
    "webgis",
    "leaflet",
    "supermap",
    "iserver",
    "gis"
  ],
  "author": {
    "name": "Satria Tesa Vici Andi",

  },
  "license": "MIT",
  "homepage": "https://github.com/satriatva/s100-chart-display#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/satriatva/s100-chart-display.git"
  },
  "dependencies": {
    "@supermapgis/iclient-leaflet": "^12.1.1",
    "express": "^4.18.2",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.35",
